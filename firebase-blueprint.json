{
  "entities": {
    "Invoice": {
      "title": "Invoice",
      "description": "Manufacturing or industrial invoice and material receipt record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "invoiceDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "poNumber": { "type": "string" },
        "deliveryChallan": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "currency": { "type": "string" },
        "vendorName": { "type": "string" },
        "vendorTaxId": { "type": "string" },
        "vendorAddress": { "type": "string" },
        "vendorPhone": { "type": "string" },
        "vendorEmail": { "type": "string" },
        "customerName": { "type": "string" },
        "customerAddress": { "type": "string" },
        "subtotal": { "type": "number" },
        "freightCharge": { "type": "number" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "discount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "manufacturingCategory": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "notes": { "type": "string" },
        "lineItems": { "type": "array" },
        "selectedFields": { "type": "array" },
        "imageUrl": { "type": "string" },
        "confidenceScore": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "invoiceDate", "vendorName", "grandTotal"]
    },
    "VendorProfile": {
      "title": "VendorProfile",
      "description": "Supplier or vendor master profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxId": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "category": { "type": "string" },
        "defaultPaymentTerms": { "type": "string" },
        "currency": { "type": "string" },
        "notes": { "type": "string" },
        "totalSpend": { "type": "number" },
        "invoiceCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection of saved manufacturing invoices"
    },
    "/vendor_profiles/{vendorId}": {
      "schema": "VendorProfile",
      "description": "Collection of supplier profiles"
    }
  }
}
